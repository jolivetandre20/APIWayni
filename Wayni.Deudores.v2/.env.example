# Copy to .env and replace every CHANGE_ME before `docker compose up`.
# .env is git-ignored: credentials never live in the repository.

# --- MySQL --------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=wayni_deudores
MYSQL_USER=wayni
MYSQL_PASSWORD=CHANGE_ME_app_password
MYSQL_PORT=3306

# --- AWS (local emulators) ----------------------------------------------
# S3Mock / ElasticMQ / LocalStack ignore credentials, but the AWS SDK requires a value.
# "test" is the conventional dummy value for local emulators. For real AWS, leave the
# *_SERVICE_URL variables empty and use real credentials (never commit them).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_SERVICE_URL=http://s3:9090
S3_BUCKET=wayni-deudores
SQS_SERVICE_URL=http://sqs:9324
SQS_QUEUE=deudores-import

# --- Notifications ------------------------------------------------------
# Shared secret between the Processor (sender) and the Admin web (webhook receiver).
WEBHOOK_SECRET=CHANGE_ME_webhook_secret
EMAIL_ENABLED=true
EMAIL_FROM=deudores@wayni.local
EMAIL_TO=equipo@wayni.local

# --- Optional: LocalStack instead of S3Mock + ElasticMQ ------------------
# Only for docker-compose.localstack.yml. Recent LocalStack images require a (free) token.
LOCALSTACK_AUTH_TOKEN=
